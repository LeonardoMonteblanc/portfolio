# ============================================================
# Variáveis de Ambiente - GuiaBG
# ============================================================
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite arquivos .env com valores reais!
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------
NODE_ENV=development
# NODE_ENV=production

# ------------------------------------------------------------
# Banco de Dados (PostgreSQL - Neon)
# ------------------------------------------------------------
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
# Desenvolvimento local (Docker):
DATABASE_URL="postgresql://dev:dev@localhost:5432/diretorio_dev"
# Produção (Neon): 
# DATABASE_URL="postgresql://neondb_owner:xxx@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------
# Autenticação (JWT)
# ------------------------------------------------------------
# Gere com: openssl rand -base64 32
# MÍNIMO 32 caracteres
JWT_SECRET="gere-um-secret-seguro-com-pelo-menos-32-chars-aqui"

# ------------------------------------------------------------
# E-mail Transacional (Resend)
# ------------------------------------------------------------
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# E-mail remetente verificado no Resend (domínio próprio)
RESEND_FROM_EMAIL="noreply@seudominio.com.br"
# Segredo do webhook do Resend (Dashboard > Webhooks > signing secret, formato whsec_...)
# Sem ele a rota /api/webhooks/resend responde 503 (falha fechada).
RESEND_WEBHOOK_SECRET=""

# ------------------------------------------------------------
# Storage de Imagens (Cloudflare R2)
# ------------------------------------------------------------
# Obtenha em: https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="diretorio-staging"
# URL pública do bucket (opcional, para CDN)
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ------------------------------------------------------------
# Rate Limit (Upstash Redis)
# ------------------------------------------------------------
# Obtenha em: https://console.upstash.com/redis
UPSTASH_REDIS_URL="https://xxx.upstash.io"
UPSTASH_REDIS_TOKEN="xxxxxxxxxxxxx"

# ------------------------------------------------------------
# Monitoramento de Erros (Sentry)
# ------------------------------------------------------------
# Obtenha em: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN="https://xxx@oxxx.ingest.sentry.io/xxx"

# ------------------------------------------------------------
# E-mails Administrativos (LGPD)
# ------------------------------------------------------------
ADMIN_EMAIL_INSTITUCIONAL="contato@seudominio.com.br"
ADMIN_EMAIL_DPO="dpo@seudominio.com.br"

# ------------------------------------------------------------
# Banco não pooled (opcional, para migrações)
# ------------------------------------------------------------
# DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------
# Neon Branch (opcional, para preview deploys)
# ------------------------------------------------------------
# NEON_BRANCH=preview